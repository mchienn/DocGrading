APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_DB=docgrading
POSTGRES_USER=docgrading
POSTGRES_PASSWORD=change-me-for-local-development
LOAD_SMOKE_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_MAX_FAILED_ATTEMPTS=30
JOIN_RATE_LIMIT_MAX_REQUESTS=10
JOIN_RATE_LIMIT_WINDOW_SECONDS=60
JOIN_RATE_LIMIT_HASH_SECRET=change-me-for-local-development-only
FORWARDED_ALLOW_IPS=172.30.255.3
STORAGE_PORT=9000
STORAGE_BUCKET=docgrading
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
STORAGE_PRESIGN_EXPIRY_SECONDS=300
# Development only (rejected when APP_ENV is not development): local copies of sealed
# PDFs re-upload objects deleted from the bucket. Compose mounts a volume for it.
# STORAGE_RECOVERY_DIR=
PDF_MAX_SIZE_BYTES=100000000
PDF_MAX_DECODED_BYTES=50000000
PDF_MAX_PAGE_COUNT=100
# Contact email for Crossref's polite pool (3 req/s instead of 1) and OpenAlex;
# an OpenAlex key raises the free title-search budget from ~100 to ~1,000 a day.
CITATION_CONTACT_EMAIL=
OPENALEX_API_KEY=
CITATION_RESOLUTION_DEADLINE_SECONDS=180
SEMANTIC_SOURCE_FETCH_ENABLED=false
SEMANTIC_SOURCE_CACHE_PREFIX=
SEMANTIC_MODEL_CALL_BUDGET=32
SEMANTIC_COVERAGE_THRESHOLD=1.0
SEMANTIC_MAX_SOURCE_BYTES=50000000
# OpenAI-compatible embeddings endpoint for semantic retrieval; empty keeps BM25.
# Self-hosted: docker compose --profile encoder, then http://encoder/v1 + BAAI/bge-m3.
SEMANTIC_ENCODER_URL=
SEMANTIC_ENCODER_MODEL=
SEMANTIC_ENCODER_API_KEY=
SEMANTIC_ENCODER_QUERY_PREFIX=
SEMANTIC_ENCODER_DOCUMENT_PREFIX=
SEMANTIC_RERANKER_URL=
LLM_CREDENTIAL_KEYRING=
LLM_CREDENTIAL_ACTIVE_KEY_ID=
# Provider keys are read from the process environment: export them (or load this file) before running `uv run` locally.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=
ANALYSIS_JOB_LEASE_SECONDS=300
ANALYSIS_JOB_HEARTBEAT_SECONDS=30
