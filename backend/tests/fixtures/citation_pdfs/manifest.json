{
  "schema_version": 1,
  "build": {
    "engine": "pdflatex",
    "working_directory": "backend/tests/fixtures/citation_pdfs",
    "powershell_command": "Get-ChildItem *.tex | ForEach-Object { pdflatex -interaction=nonstopmode -halt-on-error $_.Name }",
    "bash_command": "for source in *.tex; do pdflatex -interaction=nonstopmode -halt-on-error \"$source\"; done",
    "required_packages": ["geometry", "graphicx", "multicol", "array"],
    "status": "GENERATED"
  },
  "cases": [
    {
      "id": "one-page-numeric",
      "source": "01_one_page_numeric.tex",
      "pdf": "01_one_page_numeric.pdf",
      "page_count": 1,
      "validation": "ACCEPT",
      "bibliography_heading": "References",
      "reference_count": 2,
      "mention_count": 3,
      "link_count": 4,
      "notes": ["[0,1] is a non-citation numeric interval."]
    },
    {
      "id": "two-page-numeric",
      "source": "02_two_page_numeric.tex",
      "pdf": "02_two_page_numeric.pdf",
      "page_count": 2,
      "validation": "ACCEPT",
      "bibliography_heading": "References",
      "reference_count": 3,
      "mention_count": 3,
      "link_count": 5,
      "notes": ["Bibliography starts on page 2.", "[1-3] is rendered with a typographic dash."]
    },
    {
      "id": "author-year",
      "source": "03_author_year.tex",
      "pdf": "03_author_year.pdf",
      "page_count": 1,
      "validation": "ACCEPT",
      "bibliography_heading": "References",
      "reference_count": 3,
      "mention_count": 4,
      "link_count": 4,
      "notes": ["Covers parenthetical, grouped, and narrative author-year mentions."]
    },
    {
      "id": "footnote-citation",
      "source": "04_footnote_citation.tex",
      "pdf": "04_footnote_citation.pdf",
      "page_count": 1,
      "validation": "ACCEPT",
      "bibliography_heading": "References",
      "reference_count": 1,
      "mention_count": 1,
      "link_count": 1,
      "notes": ["Superscript footnote marker is preserved by Document IR."]
    },
    {
      "id": "scan-image-only",
      "source": "05_scan_image_only.tex",
      "asset": "05_scan_page.png",
      "pdf": "05_scan_image_only.pdf",
      "page_count": 1,
      "validation": "REJECT",
      "error_code": "PDF_SCAN_ONLY",
      "diagnostic_code": "PDF_SCAN_DETECTED",
      "citation_analysis": "NOT_RUN"
    },
    {
      "id": "complex-layout",
      "source": "06_complex_layout.tex",
      "pdf": "06_complex_layout.pdf",
      "page_count": 2,
      "validation": "ACCEPT",
      "bibliography_heading": "References",
      "reference_count": 3,
      "mention_count": 3,
      "link_count": 3,
      "notes": ["Page 1 uses two columns and a boxed callout.", "Page 2 stores references in a bordered one-column table."]
    }
  ]
}
